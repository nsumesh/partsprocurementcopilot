# Copy to backend/.env and fill in real values. NEVER commit real keys.

# Supabase project (service-role key — server-side only, bypasses RLS)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

# LLM + embedding providers
ANTHROPIC_API_KEY=sk-ant-...
COHERE_API_KEY=your-cohere-key

# Only needed for ingestion/scraper.py — the API server boots without them
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Optional overrides
# NHTSA_API_BASE=https://vpic.nhtsa.dot.gov/api/vehicles
# SQLITE_FTS_PATH=fts_index.db

# Security (set these in production)
# Comma-separated allowed origins; "*" allows all (dev only)
CORS_ORIGINS=*
# If set, every non-/health request must send a matching X-API-Key header
# API_KEY=
# Per-IP POST requests per minute; 0 disables
RATE_LIMIT_PER_MINUTE=30
