# Copy to frontend/.env and fill in real values. NEVER commit real keys.
# These are BUILD-TIME variables (Vite inlines them) — on Railway they must be
# supplied as build args, not runtime variables.

VITE_API_BASE_URL=http://localhost:8000

# Anon (publishable) key only — used for the Realtime subscription on the board
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
